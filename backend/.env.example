# Local development defaults
# Vercel uses stateless simulations and browser session storage: no database needed.
POLICYFORGE_SESSION_ONLY=true

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Gemini interpretation. Keep GEMINI_API_KEY server-side only.
POLICYFORGE_AI_MODE=rule_based
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
