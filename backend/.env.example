# Local development defaults
# Leave DATABASE_URL unset to use the local SQLite database.
# For Vercel + Neon, set DATABASE_URL in Vercel Project Settings instead.
DATABASE_URL=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional AI interpretation. Keep OPENAI_API_KEY server-side only.
POLICYFORGE_AI_MODE=rule_based
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
